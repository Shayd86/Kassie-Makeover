<Window x:Class="Kassie.Makeover.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Kassie Makeover" Width="1380" Height="860" MinWidth="1040" MinHeight="680"
        WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="CanResize"
        Background="{StaticResource BgBrush}" Foreground="{StaticResource TextBrush}"
        Closing="Window_Closing">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="42" ResizeBorderThickness="7" CornerRadius="0" GlassFrameThickness="0" UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="42"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#0B0D19" BorderBrush="#222741" BorderThickness="0,0,0,1" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="46"/>
                    <ColumnDefinition Width="46"/>
                    <ColumnDefinition Width="46"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="VersionText" Margin="14,0" VerticalAlignment="Center" Foreground="#C8CDE4" FontSize="13" Text="Kassie Makeover  •  v0.4.0  •  C# / WPF"/>
                <Button Grid.Column="1" Content="—" Style="{StaticResource NavButton}" HorizontalContentAlignment="Center" shell:WindowChrome.IsHitTestVisibleInChrome="True" Click="Minimize_Click"/>
                <Button Grid.Column="2" Content="□" Style="{StaticResource NavButton}" HorizontalContentAlignment="Center" shell:WindowChrome.IsHitTestVisibleInChrome="True" Click="Maximize_Click"/>
                <Button Grid.Column="3" Content="✕" Style="{StaticResource NavButton}" HorizontalContentAlignment="Center" shell:WindowChrome.IsHitTestVisibleInChrome="True" Click="Close_Click"/>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="248"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="#0A0C18" BorderBrush="#20243C" BorderThickness="0,0,1,0" Padding="18">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top">
                        <Image Source="/Assets/kassie-makeover-approved.jpg" Stretch="Uniform" Height="62" HorizontalAlignment="Left" Margin="0,3,0,24"/>
                        <Button Content="◉   Live Mirror" Tag="Live Mirror" Style="{StaticResource NavButton}" Click="Nav_Click"/>
                        <Button Content="✦   Makeup" Tag="Makeup" Style="{StaticResource NavButton}" Click="Nav_Click"/>
                        <Button Content="⌁   Hair" Tag="Hair" Style="{StaticResource NavButton}" Click="Nav_Click"/>
                        <Button Content="♢   Outfit" Tag="Outfit" Style="{StaticResource NavButton}" Click="Nav_Click"/>
                        <Button Content="♥   Looks" Tag="Looks" Style="{StaticResource NavButton}" Click="Nav_Click"/>
                        <Button Content="▦   Wardrobe" Tag="Wardrobe" Style="{StaticResource NavButton}" Click="Nav_Click"/>
                    </StackPanel>
                    <StackPanel DockPanel.Dock="Bottom" VerticalAlignment="Bottom">
                        <Border Background="#0E1725" BorderBrush="#223F53" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,8">
                            <StackPanel>
                                <TextBlock Text="Storage" Foreground="{StaticResource MutedBrush}" FontSize="11"/>
                                <TextBlock Text="D:\Kassie\Makeover" Foreground="{StaticResource CyanBrush}" Margin="0,4,0,0" FontSize="12" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                        <TextBlock Text="Native C# desktop app • no browser" Foreground="#68708F" FontSize="10" TextWrapping="Wrap"/>
                    </StackPanel>
                </DockPanel>
            </Border>

            <Grid Grid.Column="1" Margin="26,20,26,24">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock x:Name="PageTitle" Text="Live Mirror" FontSize="29" FontWeight="Bold"/>
                        <TextBlock x:Name="PageSubtitle" Text="Your starting point for every look." Foreground="{StaticResource MutedBrush}" FontSize="13" Margin="0,5,0,0"/>
                    </StackPanel>
                    <Border Grid.Column="1" Background="#101B22" BorderBrush="#24586A" BorderThickness="1" CornerRadius="14" Padding="11,6" VerticalAlignment="Center">
                        <TextBlock x:Name="GlobalStatus" Text="Initializing…" Foreground="{StaticResource CyanBrush}" FontSize="12"/>
                    </Border>
                </Grid>

                <Grid Grid.Row="1">
                    <Grid x:Name="LivePage">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="3*"/>
                            <ColumnDefinition Width="360"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Background="#050711" BorderBrush="#24294A" BorderThickness="1" CornerRadius="14" Margin="0,0,16,0" ClipToBounds="True">
                            <Grid>
                                <Image x:Name="PreviewImage" Stretch="Uniform" SnapsToDevicePixels="True"/>
                                <StackPanel x:Name="CameraPlaceholder" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock Text="◎" Foreground="#45506F" FontSize="54" HorizontalAlignment="Center"/>
                                    <TextBlock Text="Camera preview" Foreground="#8E96B5" FontSize="18" HorizontalAlignment="Center" Margin="0,12,0,0"/>
                                    <TextBlock Text="Choose a camera and press Start camera." Foreground="#636B89" FontSize="12" HorizontalAlignment="Center" Margin="0,6,0,0"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <Border Background="{StaticResource PanelBrush}" BorderBrush="#2A3053" BorderThickness="1" CornerRadius="12" Padding="16" Margin="0,0,0,12">
                                    <StackPanel>
                                        <TextBlock Text="Camera" FontSize="16" FontWeight="Bold"/>
                                        <TextBlock Text="Device" Foreground="{StaticResource MutedBrush}" Margin="0,12,0,5" FontSize="11"/>
                                        <ComboBox x:Name="CameraCombo" MinHeight="34" DisplayMemberPath="DisplayName" SelectionChanged="CameraCombo_SelectionChanged"/>
                                        <WrapPanel Margin="-4,10,-4,0">
                                            <Button x:Name="StartCameraButton" Content="Start camera" Style="{StaticResource ActionButton}" Click="StartCamera_Click"/>
                                            <Button Content="Refresh" Style="{StaticResource ActionButton}" Click="RefreshCameras_Click"/>
                                        </WrapPanel>
                                        <CheckBox x:Name="MirrorCheck" Content="Mirror preview" IsChecked="True" Foreground="White" Margin="4,12,0,0" Checked="MirrorCheck_Changed" Unchecked="MirrorCheck_Changed"/>
                                    </StackPanel>
                                </Border>

                                <Border Background="{StaticResource PanelBrush}" BorderBrush="#2A3053" BorderThickness="1" CornerRadius="12" Padding="16" Margin="0,0,0,12">
                                    <StackPanel>
                                        <TextBlock Text="Capture" FontSize="16" FontWeight="Bold"/>
                                        <TextBlock Text="Snapshots are saved outside the app folder so Hub updates cannot overwrite them." Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,8,0,10" FontSize="11"/>
                                        <Button Content="Capture photo" Style="{StaticResource ActionButton}" Click="Capture_Click"/>
                                        <Button Content="Open output folder" Style="{StaticResource ActionButton}" Click="OpenOutputs_Click"/>
                                    </StackPanel>
                                </Border>

                                <Border Background="#0C1320" BorderBrush="#1D3A49" BorderThickness="1" CornerRadius="12" Padding="14">
                                    <StackPanel>
                                        <TextBlock Text="Camera status" Foreground="{StaticResource MutedBrush}" FontSize="11"/>
                                        <TextBlock x:Name="CameraStatusText" Text="Camera off" Foreground="#E7EAF8" TextWrapping="Wrap" Margin="0,5,0,0"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>

                    <Grid x:Name="MakeupPage" Visibility="Collapsed">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="3*"/>
                            <ColumnDefinition Width="400"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Background="#050711" BorderBrush="#4A2551" BorderThickness="1" CornerRadius="14" Margin="0,0,16,0" ClipToBounds="True">
                            <Grid>
                                <Image x:Name="MakeupPreviewImage" Stretch="Uniform" SnapsToDevicePixels="True"/>
                                <StackPanel x:Name="MakeupCameraPlaceholder" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock Text="✦" Foreground="{StaticResource PinkBrush}" FontSize="54" HorizontalAlignment="Center"/>
                                    <TextBlock Text="Makeup mirror" Foreground="#E9D8EA" FontSize="18" HorizontalAlignment="Center" Margin="0,12,0,0"/>
                                    <TextBlock Text="Start the camera to try makeup or get style suggestions." Foreground="#79697D" FontSize="12" HorizontalAlignment="Center" Margin="0,6,0,12"/>
                                    <Button Content="Start camera" Style="{StaticResource ActionButton}" Click="MakeupStartCamera_Click"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <Border Background="{StaticResource PanelBrush}" BorderBrush="#512E56" BorderThickness="1" CornerRadius="12" Padding="16" Margin="0,0,0,12">
                                    <StackPanel>
                                        <TextBlock Text="Makeup mode" FontSize="17" FontWeight="Bold"/>
                                        <TextBlock Text="Try makeup on, or let Kassie suggest a direction from the face the camera can see." Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,6,0,10" FontSize="11"/>
                                        <WrapPanel Margin="-4,0">
                                            <Button x:Name="TryOnModeButton" Content="Try On" Tag="TryOn" Style="{StaticResource ActionButton}" Click="MakeupMode_Click"/>
                                            <Button x:Name="StyleModeButton" Content="Style Me" Tag="StyleMe" Style="{StaticResource ActionButton}" Click="MakeupMode_Click"/>
                                        </WrapPanel>
                                        <TextBlock x:Name="MakeupModeHint" Text="TRY ON • Choose shades, finishes and placement." Foreground="{StaticResource CyanBrush}" Margin="4,8,0,0" FontSize="11"/>
                                    </StackPanel>
                                </Border>

                                <StackPanel x:Name="TryOnPanel">
                                    <Border Background="{StaticResource PanelBrush}" BorderBrush="#512E56" BorderThickness="1" CornerRadius="12" Padding="16" Margin="0,0,0,12">
                                        <StackPanel>
                                            <TextBlock Text="Live Try-On  •  Beta" FontSize="17" FontWeight="Bold"/>
                                            <TextBlock Text="Colour is feathered over the camera image so skin and lip texture stay visible. Tracking still runs locally." Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,7,0,10" FontSize="11"/>
                                            <CheckBox x:Name="LiveMakeupCheck" Content="Enable live makeup" IsChecked="True" Foreground="White" Margin="0,4" Checked="MakeupControl_Changed" Unchecked="MakeupControl_Changed"/>
                                            <TextBlock x:Name="MakeupModelStatus" Text="Face tracking not loaded yet" Foreground="{StaticResource PinkBrush}" TextWrapping="Wrap" Margin="0,8,0,10" FontSize="11"/>
                                            <WrapPanel Margin="-4,0">
                                                <Button Content="Capture makeover" Style="{StaticResource ActionButton}" Click="CaptureMakeup_Click"/>
                                                <Button Content="Open captures" Style="{StaticResource ActionButton}" Click="OpenOutputs_Click"/>
                                            </WrapPanel>
                                        </StackPanel>
                                    </Border>

                                    <Border Background="{StaticResource PanelBrush}" BorderBrush="#2A3053" BorderThickness="1" CornerRadius="12" Padding="16" Margin="0,0,0,12">
                                        <StackPanel>
                                            <TextBlock Text="Strength" FontSize="15" FontWeight="Bold"/>
                                            <Slider x:Name="MakeupIntensitySlider" Minimum="0" Maximum="100" Value="35" TickFrequency="5" Margin="0,8,0,0" ValueChanged="MakeupControl_Changed"/>
                                            <TextBlock x:Name="MakeupIntensityText" Text="35%" Foreground="{StaticResource CyanBrush}" HorizontalAlignment="Right"/>
                                        </StackPanel>
                                    </Border>

                                    <Border Background="{StaticResource PanelBrush}" BorderBrush="#2A3053" BorderThickness="1" CornerRadius="12" Padding="16" Margin="0,0,0,12">
                                        <StackPanel>
                                            <CheckBox x:Name="LipstickCheck" Content="Lips" IsChecked="True" Foreground="White" FontWeight="SemiBold" Checked="MakeupControl_Changed" Unchecked="MakeupControl_Changed"/>
                                            <Grid Margin="0,8,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="10"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <TextBlock Text="Shade" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,0,0,4"/>
                                                    <ComboBox x:Name="LipColorCombo" MinHeight="32" SelectionChanged="MakeupControl_Changed"/>
                                                </StackPanel>
                                                <StackPanel Grid.Column="2">
                                                    <TextBlock Text="Finish" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,0,0,4"/>
                                                    <ComboBox x:Name="LipFinishCombo" MinHeight="32" SelectionChanged="MakeupControl_Changed"/>
                                                </StackPanel>
                                            </Grid>
                                        </StackPanel>
                                    </Border>

                                    <Border Background="{StaticResource PanelBrush}" BorderBrush="#2A3053" BorderThickness="1" CornerRadius="12" Padding="16" Margin="0,0,0,12">
                                        <StackPanel>
                                            <CheckBox x:Name="BlushCheck" Content="Blush" IsChecked="True" Foreground="White" FontWeight="SemiBold" Checked="MakeupControl_Changed" Unchecked="MakeupControl_Changed"/>
                                            <Grid Margin="0,8,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="10"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <TextBlock Text="Shade" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,0,0,4"/>
                                                    <ComboBox x:Name="BlushColorCombo" MinHeight="32" SelectionChanged="MakeupControl_Changed"/>
                                                </StackPanel>
                                                <StackPanel Grid.Column="2">
                                                    <TextBlock Text="Placement" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,0,0,4"/>
                                                    <ComboBox x:Name="BlushPlacementCombo" MinHeight="32" SelectionChanged="MakeupControl_Changed"/>
                                                </StackPanel>
                                            </Grid>
                                        </StackPanel>
                                    </Border>

                                    <Border Background="{StaticResource PanelBrush}" BorderBrush="#2A3053" BorderThickness="1" CornerRadius="12" Padding="16">
                                        <StackPanel>
                                            <CheckBox x:Name="EyeshadowCheck" Content="Eyes" IsChecked="True" Foreground="White" FontWeight="SemiBold" Checked="MakeupControl_Changed" Unchecked="MakeupControl_Changed"/>
                                            <Grid Margin="0,8,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="10"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <TextBlock Text="Shade" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,0,0,4"/>
                                                    <ComboBox x:Name="EyeColorCombo" MinHeight="32" SelectionChanged="MakeupControl_Changed"/>
                                                </StackPanel>
                                                <StackPanel Grid.Column="2">
                                                    <TextBlock Text="Style" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,0,0,4"/>
                                                    <ComboBox x:Name="EyeStyleCombo" MinHeight="32" SelectionChanged="MakeupControl_Changed"/>
                                                </StackPanel>
                                            </Grid>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>

                                <StackPanel x:Name="StyleAdvisorPanel" Visibility="Collapsed">
                                    <Border Background="{StaticResource PanelBrush}" BorderBrush="#512E56" BorderThickness="1" CornerRadius="12" Padding="16" Margin="0,0,0,12">
                                        <StackPanel>
                                            <TextBlock Text="Style Me" FontSize="18" FontWeight="Bold"/>
                                            <TextBlock Text="Kassie makes a rough read of proportions and eye spacing from the live camera, then suggests makeup placement and intensity. It is a style helper, not a beauty score." Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,7,0,12" FontSize="11"/>
                                            <TextBlock Text="What are we aiming for?" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,0,0,4"/>
                                            <ComboBox x:Name="StyleVibeCombo" MinHeight="34"/>
                                            <Button Content="Analyse current face" Style="{StaticResource ActionButton}" Margin="0,10,0,0" Click="AnalyseFace_Click"/>
                                        </StackPanel>
                                    </Border>

                                    <Border Background="#0C1320" BorderBrush="#1D3A49" BorderThickness="1" CornerRadius="12" Padding="16" Margin="0,0,0,12">
                                        <StackPanel>
                                            <TextBlock Text="Camera read" Foreground="{StaticResource MutedBrush}" FontSize="11"/>
                                            <TextBlock x:Name="FaceAnalysisText" Text="Start the camera, face it fairly straight-on, then analyse." Foreground="#E7EAF8" TextWrapping="Wrap" Margin="0,6,0,0"/>
                                        </StackPanel>
                                    </Border>

                                    <Border Background="{StaticResource PanelBrush}" BorderBrush="#2A3053" BorderThickness="1" CornerRadius="12" Padding="16">
                                        <StackPanel>
                                            <TextBlock x:Name="RecommendationTitle" Text="No suggestion yet" FontSize="17" FontWeight="Bold"/>
                                            <TextBlock x:Name="RecommendationSummary" Text="Kassie will suggest a lip finish, blush placement and eye style." Foreground="{StaticResource CyanBrush}" TextWrapping="Wrap" Margin="0,7,0,0"/>
                                            <TextBlock x:Name="RecommendationWhy" Text="" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,8,0,10" FontSize="11"/>
                                            <Button x:Name="ApplyRecommendationButton" Content="Try this look" IsEnabled="False" Style="{StaticResource ActionButton}" Click="ApplyRecommendation_Click"/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>

                    <Grid x:Name="HairPage" Visibility="Collapsed">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="3*"/>
                            <ColumnDefinition Width="410"/>
                        </Grid.ColumnDefinitions>

                        <Grid Grid.Column="0" Margin="0,0,16,0">
                            <Border x:Name="HairstyleWorkspace" Background="#050711" BorderBrush="#244A50" BorderThickness="1" CornerRadius="14" Padding="14">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <Grid Margin="2,0,2,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="BEFORE" Foreground="#747C9B" FontSize="11" FontWeight="Bold"/>
                                        <TextBlock Grid.Column="1" Text="HAIRSTYLE RESULT" Foreground="{StaticResource CyanBrush}" FontSize="11" FontWeight="Bold" Margin="14,0,0,0"/>
                                    </Grid>

                                    <Grid Grid.Row="1">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="14"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <Border Background="#080A14" BorderBrush="#24294A" BorderThickness="1" CornerRadius="10" ClipToBounds="True">
                                            <Grid>
                                                <Image x:Name="HairstyleSourceImage" Stretch="Uniform"/>
                                                <StackPanel x:Name="HairstyleSourcePlaceholder" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="22">
                                                    <TextBlock Text="◎" Foreground="#45506F" FontSize="48" HorizontalAlignment="Center"/>
                                                    <TextBlock Text="Choose your photo" Foreground="#D7DAED" FontSize="17" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,10,0,0"/>
                                                    <TextBlock Text="Capture from the webcam or import a clear portrait." Foreground="#6E7696" FontSize="11" TextAlignment="Center" TextWrapping="Wrap" Margin="0,6,0,0"/>
                                                </StackPanel>
                                            </Grid>
                                        </Border>

                                        <Border Grid.Column="2" Background="#080A14" BorderBrush="#2A4F55" BorderThickness="1" CornerRadius="10" ClipToBounds="True">
                                            <Grid>
                                                <Image x:Name="HairstyleResultImage" Stretch="Uniform"/>
                                                <StackPanel x:Name="HairstyleResultPlaceholder" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="22">
                                                    <TextBlock Text="✦" Foreground="{StaticResource CyanBrush}" FontSize="48" HorizontalAlignment="Center"/>
                                                    <TextBlock Text="Result area ready" Foreground="#D7DAED" FontSize="17" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,10,0,0"/>
                                                    <TextBlock x:Name="HairstyleResultStatusText" Text="Build a hairstyle request on the right. The still-image renderer will plug into this result panel." Foreground="#6E7696" FontSize="11" TextAlignment="Center" TextWrapping="Wrap" Margin="0,6,0,0"/>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </Grid>

                                    <Border Grid.Row="2" Background="#0C1320" BorderBrush="#1D3A49" BorderThickness="1" CornerRadius="9" Padding="10" Margin="0,12,0,0">
                                        <TextBlock x:Name="HairSourceStatusText" Text="No source photo selected." Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" FontSize="11"/>
                                    </Border>
                                </Grid>
                            </Border>

                            <Border x:Name="HairColourWorkspace" Visibility="Collapsed" Background="#050711" BorderBrush="#244A50" BorderThickness="1" CornerRadius="14" ClipToBounds="True">
                                <Grid>
                                    <Image x:Name="HairPreviewImage" Stretch="Uniform" SnapsToDevicePixels="True"/>
                                    <StackPanel x:Name="HairCameraPlaceholder" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <TextBlock Text="⌁" Foreground="{StaticResource CyanBrush}" FontSize="54" HorizontalAlignment="Center"/>
                                        <TextBlock Text="Live hair colour" Foreground="#D9F7FA" FontSize="18" HorizontalAlignment="Center" Margin="0,12,0,0"/>
                                        <TextBlock Text="Start the camera for the quick colour preview." Foreground="#697D82" FontSize="12" HorizontalAlignment="Center" Margin="0,6,0,12"/>
                                        <Button Content="Start camera" Style="{StaticResource ActionButton}" Click="HairStartCamera_Click"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </Grid>

                        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <Border Background="{StaticResource PanelBrush}" BorderBrush="#28515A" BorderThickness="1" CornerRadius="12" Padding="16" Margin="0,0,0,12">
                                    <StackPanel>
                                        <TextBlock Text="Hair mode" FontSize="17" FontWeight="Bold"/>
                                        <TextBlock Text="Hairstyles are the main event now. Live colour stays available as a quick beta preview." Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,6,0,10" FontSize="11"/>
                                        <WrapPanel Margin="-4,0">
                                            <Button Content="Hairstyles" Tag="Hairstyles" Style="{StaticResource ActionButton}" Click="HairMode_Click"/>
                                            <Button Content="Hair Colour  •  Beta" Tag="Colour" Style="{StaticResource ActionButton}" Click="HairMode_Click"/>
                                        </WrapPanel>
                                        <TextBlock x:Name="HairModeHint" Text="HAIRSTYLES • Capture or import a portrait, then build the style." Foreground="{StaticResource CyanBrush}" Margin="4,8,0,0" FontSize="11"/>
                                    </StackPanel>
                                </Border>

                                <StackPanel x:Name="HairstylePanel">
                                    <Border Background="{StaticResource PanelBrush}" BorderBrush="#2A3053" BorderThickness="1" CornerRadius="12" Padding="16" Margin="0,0,0,12">
                                        <StackPanel>
                                            <TextBlock Text="1. Your photo" FontSize="16" FontWeight="Bold"/>
                                            <TextBlock Text="A front-facing or slightly turned portrait works best. Camera captures are copied into persistent hairstyle input storage." Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,6,0,10" FontSize="11"/>
                                            <WrapPanel Margin="-4,0">
                                                <Button Content="Capture from camera" Style="{StaticResource ActionButton}" Click="CaptureHairstyleSource_Click"/>
                                                <Button Content="Import photo" Style="{StaticResource ActionButton}" Click="ImportHairstyleSource_Click"/>
                                                <Button Content="Clear" Style="{StaticResource ActionButton}" Click="ClearHairstyleSource_Click"/>
                                            </WrapPanel>
                                        </StackPanel>
                                    </Border>

                                    <Border Background="{StaticResource PanelBrush}" BorderBrush="#2A3053" BorderThickness="1" CornerRadius="12" Padding="16" Margin="0,0,0,12">
                                        <StackPanel>
                                            <TextBlock Text="2. Hairstyle" FontSize="16" FontWeight="Bold"/>
                                            <TextBlock Text="Style family" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,9,0,4"/>
                                            <ComboBox x:Name="HairStyleFamilyCombo" MinHeight="32" SelectionChanged="HairControl_Changed"/>

                                            <Grid Margin="0,10,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="10"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <TextBlock Text="Length" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,0,0,4"/>
                                                    <ComboBox x:Name="HairLengthCombo" MinHeight="32" SelectionChanged="HairControl_Changed"/>
                                                </StackPanel>
                                                <StackPanel Grid.Column="2">
                                                    <TextBlock Text="Texture" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,0,0,4"/>
                                                    <ComboBox x:Name="HairTextureCombo" MinHeight="32" SelectionChanged="HairControl_Changed"/>
                                                </StackPanel>
                                            </Grid>

                                            <Grid Margin="0,10,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="10"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <TextBlock Text="Fringe" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,0,0,4"/>
                                                    <ComboBox x:Name="HairFringeCombo" MinHeight="32" SelectionChanged="HairControl_Changed"/>
                                                </StackPanel>
                                                <StackPanel Grid.Column="2">
                                                    <TextBlock Text="Volume" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,0,0,4"/>
                                                    <ComboBox x:Name="HairVolumeCombo" MinHeight="32" SelectionChanged="HairControl_Changed"/>
                                                </StackPanel>
                                            </Grid>

                                            <TextBlock x:Name="HairStyleSummary" Text="Layered • Medium • Wavy • No fringe • Natural volume" Foreground="{StaticResource CyanBrush}" TextWrapping="Wrap" Margin="0,12,0,0"/>
                                        </StackPanel>
                                    </Border>

                                    <Border Background="{StaticResource PanelBrush}" BorderBrush="#2A3053" BorderThickness="1" CornerRadius="12" Padding="16" Margin="0,0,0,12">
                                        <StackPanel>
                                            <TextBlock Text="3. Reference hairstyle  •  Optional" FontSize="16" FontWeight="Bold"/>
                                            <TextBlock Text="Add photos you like. The selected reference travels with the hairstyle request and your saved Look." Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,6,0,10" FontSize="11"/>
                                            <WrapPanel Margin="-4,0,0,8">
                                                <Button Content="+ Add reference" Style="{StaticResource ActionButton}" Click="AddHairReference_Click"/>
                                                <Button Content="Use selected" Style="{StaticResource ActionButton}" Click="UseHairReference_Click"/>
                                                <Button Content="Remove" Style="{StaticResource ActionButton}" Click="RemoveHairReference_Click"/>
                                            </WrapPanel>
                                            <ListBox x:Name="HairReferenceList" Height="190" Background="#080A14" BorderBrush="#2B3152" SelectionChanged="HairReferenceList_SelectionChanged">
                                                <ListBox.ItemTemplate>
                                                    <DataTemplate>
                                                        <Grid Margin="4">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="58"/>
                                                                <ColumnDefinition Width="*"/>
                                                            </Grid.ColumnDefinitions>
                                                            <Border Width="50" Height="50" Background="#050711" CornerRadius="6" ClipToBounds="True">
                                                                <Image Source="{Binding FilePath}" Stretch="UniformToFill"/>
                                                            </Border>
                                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="8,0,0,0">
                                                                <TextBlock Text="{Binding Name}" Foreground="#E7EAF8" TextTrimming="CharacterEllipsis"/>
                                                                <TextBlock Text="{Binding AddedAt, StringFormat='Added {0:d}'}" Foreground="#747C9B" FontSize="10"/>
                                                            </StackPanel>
                                                        </Grid>
                                                    </DataTemplate>
                                                </ListBox.ItemTemplate>
                                            </ListBox>
                                            <TextBlock x:Name="SelectedHairReferenceText" Text="No reference selected" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,8,0,0" FontSize="11"/>
                                        </StackPanel>
                                    </Border>

                                    <Border Background="#0C1320" BorderBrush="#1D3A49" BorderThickness="1" CornerRadius="12" Padding="16">
                                        <StackPanel>
                                            <TextBlock Text="4. Prepare the render" FontSize="16" FontWeight="Bold"/>
                                            <TextBlock Text="v0.7 builds and saves the complete still-image hairstyle request. The generated result panel is already wired for the image renderer that comes next; it does not fake a haircut with another webcam blob." Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,7,0,10" FontSize="11"/>
                                            <Button Content="Prepare hairstyle render" Style="{StaticResource ActionButton}" Click="PrepareHairstyle_Click"/>
                                            <TextBlock x:Name="HairRenderStatusText" Text="Choose a source photo first." Foreground="{StaticResource CyanBrush}" TextWrapping="Wrap" Margin="4,8,0,0" FontSize="11"/>
                                            <Button Content="Open hairstyle folder" Style="{StaticResource ActionButton}" Margin="0,8,0,0" Click="OpenHairFolder_Click"/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>

                                <StackPanel x:Name="HairColourPanel" Visibility="Collapsed">
                                    <Border Background="{StaticResource PanelBrush}" BorderBrush="#28515A" BorderThickness="1" CornerRadius="12" Padding="16" Margin="0,0,0,12">
                                        <StackPanel>
                                            <TextBlock Text="Live Hair Colour  •  Beta" FontSize="17" FontWeight="Bold"/>
                                            <TextBlock Text="This remains the fast local experiment. It keeps your actual hair texture but still uses the conservative face-anchored mask from v0.6." Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,7,0,10" FontSize="11"/>
                                            <CheckBox x:Name="LiveHairCheck" Content="Enable live hair colour" IsChecked="True" Foreground="White" Margin="0,4" Checked="HairControl_Changed" Unchecked="HairControl_Changed"/>
                                            <TextBlock x:Name="HairTrackingStatus" Text="Face/hair tracking not loaded yet" Foreground="{StaticResource PinkBrush}" TextWrapping="Wrap" Margin="0,8,0,10" FontSize="11"/>
                                            <WrapPanel Margin="-4,0">
                                                <Button Content="Capture hair colour" Style="{StaticResource ActionButton}" Click="CaptureHair_Click"/>
                                                <Button Content="Open captures" Style="{StaticResource ActionButton}" Click="OpenOutputs_Click"/>
                                            </WrapPanel>
                                        </StackPanel>
                                    </Border>

                                    <Border Background="{StaticResource PanelBrush}" BorderBrush="#2A3053" BorderThickness="1" CornerRadius="12" Padding="16" Margin="0,0,0,12">
                                        <StackPanel>
                                            <TextBlock Text="Colour strength" FontSize="15" FontWeight="Bold"/>
                                            <Slider x:Name="HairIntensitySlider" Minimum="0" Maximum="100" Value="32" TickFrequency="5" Margin="0,8,0,0" ValueChanged="HairControl_Changed"/>
                                            <TextBlock x:Name="HairIntensityText" Text="32%" Foreground="{StaticResource CyanBrush}" HorizontalAlignment="Right"/>
                                        </StackPanel>
                                    </Border>

                                    <Border Background="{StaticResource PanelBrush}" BorderBrush="#2A3053" BorderThickness="1" CornerRadius="12" Padding="16">
                                        <StackPanel>
                                            <TextBlock Text="Colour" FontSize="15" FontWeight="Bold"/>
                                            <TextBlock Text="Shade" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,8,0,4"/>
                                            <ComboBox x:Name="HairColorCombo" MinHeight="32" SelectionChanged="HairControl_Changed"/>
                                            <Grid Margin="0,10,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="10"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <TextBlock Text="Finish" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,0,0,4"/>
                                                    <ComboBox x:Name="HairFinishCombo" MinHeight="32" SelectionChanged="HairControl_Changed"/>
                                                </StackPanel>
                                                <StackPanel Grid.Column="2">
                                                    <TextBlock Text="Coverage" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,0,0,4"/>
                                                    <ComboBox x:Name="HairCoverageCombo" MinHeight="32" SelectionChanged="HairControl_Changed"/>
                                                </StackPanel>
                                            </Grid>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>

                    <Grid x:Name="LooksPage" Visibility="Collapsed">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="420"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Background="{StaticResource PanelBrush}" BorderBrush="#2A3053" BorderThickness="1" CornerRadius="14" Padding="20" Margin="0,0,16,0">
                            <StackPanel>
                                <TextBlock Text="Save current look" FontSize="18" FontWeight="Bold"/>
                                <TextBlock Text="A Look now stores your makeup and hair choices together. Outfit settings will join the same preset system when try-on lands." Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,7,0,14"/>
                                <TextBox x:Name="LookNameBox" Height="34" Padding="8,5" Text="My look"/>
                                <Button Content="Save current makeup as look" Style="{StaticResource ActionButton}" Margin="0,10,0,0" Click="SaveLook_Click"/>
                                <Separator Margin="0,14"/>
                                <ListBox x:Name="LooksList" MinHeight="250" DisplayMemberPath="Name" SelectionChanged="LooksList_SelectionChanged"/>
                                <WrapPanel Margin="-4,10,-4,0">
                                    <Button Content="Load selected" Style="{StaticResource ActionButton}" Click="LoadLook_Click"/>
                                    <Button Content="Delete" Style="{StaticResource ActionButton}" Click="DeleteLook_Click"/>
                                </WrapPanel>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="1" Background="#0B0E1D" BorderBrush="#352445" BorderThickness="1" CornerRadius="14" Padding="28">
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="♥" Foreground="{StaticResource PinkBrush}" FontSize="54" HorizontalAlignment="Center"/>
                                <TextBlock Text="Your Looks" FontSize="28" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,12,0,0"/>
                                <TextBlock x:Name="LooksSummary" Text="Save a makeup combination, then reload it whenever you want." Foreground="{StaticResource MutedBrush}" TextAlignment="Center" TextWrapping="Wrap" FontSize="14" Margin="0,10,0,0"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <Grid x:Name="WardrobePage" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Border Background="{StaticResource PanelBrush}" BorderBrush="#2A3053" BorderThickness="1" CornerRadius="12" Padding="12" Margin="0,0,0,12">
                            <DockPanel>
                                <TextBlock Text="Import clothing photos now; live and still-image try-on will use this library." Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" TextWrapping="Wrap" Margin="6,0,12,0"/>
                                <WrapPanel DockPanel.Dock="Right" HorizontalAlignment="Right">
                                    <Button Content="+ Add items" Style="{StaticResource ActionButton}" Click="AddWardrobe_Click"/>
                                    <Button Content="Remove selected" Style="{StaticResource ActionButton}" Click="RemoveWardrobe_Click"/>
                                    <Button Content="Open folder" Style="{StaticResource ActionButton}" Click="OpenWardrobe_Click"/>
                                </WrapPanel>
                            </DockPanel>
                        </Border>

                        <Grid Grid.Row="1">
                            <ListBox x:Name="WardrobeList" Background="Transparent" BorderThickness="0" SelectionMode="Single">
                                <ListBox.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel/>
                                    </ItemsPanelTemplate>
                                </ListBox.ItemsPanel>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Border Width="180" Height="230" Margin="7" Background="#101328" BorderBrush="#2B3152" BorderThickness="1" CornerRadius="12" Padding="8">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="*"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>
                                                <Border Background="#080A14" CornerRadius="8" ClipToBounds="True">
                                                    <Image Source="{Binding FilePath}" Stretch="Uniform"/>
                                                </Border>
                                                <TextBlock Grid.Row="1" Text="{Binding Name}" TextTrimming="CharacterEllipsis" Margin="2,8,2,2" Foreground="#E7EAF8"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <TextBlock x:Name="WardrobeEmptyText" Text="Your wardrobe is empty. Add clothing photos to start building it." Foreground="#747C9B" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                    </Grid>

                    <Border x:Name="PlaceholderPage" Visibility="Collapsed" Background="{StaticResource PanelBrush}" BorderBrush="#2A3053" BorderThickness="1" CornerRadius="14" Padding="40">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="650">
                            <TextBlock x:Name="PlaceholderIcon" Text="⌁" FontSize="54" Foreground="{StaticResource PinkBrush}" HorizontalAlignment="Center"/>
                            <TextBlock x:Name="PlaceholderTitle" Text="Hair" FontSize="30" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,14,0,0"/>
                            <TextBlock x:Name="PlaceholderText" Text="This section is next." Foreground="{StaticResource MutedBrush}" FontSize="14" TextAlignment="Center" TextWrapping="Wrap" Margin="0,10,0,0"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</Window>
